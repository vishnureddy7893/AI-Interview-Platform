# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/AIHiringPlatform

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Request timeout and automatic retries for AI calls
GROQ_TIMEOUT_MS=60000
GROQ_MAX_RETRIES=2

# Background resume analysis
# Attempts per resume before the job is marked failed
RESUME_ANALYSIS_MAX_ATTEMPTS=3
# Delay before the first automatic retry (doubles each attempt)
RESUME_ANALYSIS_RETRY_DELAY_MS=15000

# Judge0 CE (code execution)
# Self-hosted example: http://localhost:2358
# RapidAPI example: https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_MAX_POLLS=30

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
# Gmail requires a 16-character App Password (2FA must be enabled),
# not your normal account password.
EMAIL_PASS=

# ---------------------------------------------------------------------------
# TLS trust (only needed behind a TLS-inspecting proxy or antivirus)
# ---------------------------------------------------------------------------
# Symptom: "self-signed certificate in certificate chain" on SMTP or Groq calls.
# Cause:   Node.js does not read the OS certificate store, so the root CA your
#          proxy/antivirus injects is unknown to it (your browser trusts it).
#
# Pick ONE of these — all keep certificate verification ENABLED:
#
#   1. Run with the OS trust store (Node 22.15+ / 23.5+):
#        npm run start:system-ca      (or: npm run dev:system-ca)
#
#   2. Point Node at the exported root certificate (set as an OS env var):
#        NODE_EXTRA_CA_CERTS=C:\path\to\corporate-root.pem
#
#   3. App-level equivalent — relative paths resolve from backend/:
# EXTRA_CA_CERT_PATH=./certs/corporate-root.pem
#
# Last resort, DEV ONLY. Disables SMTP certificate verification.
# Never set this in production.
# SMTP_ALLOW_SELF_SIGNED=true
